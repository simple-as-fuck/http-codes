{
    "name": "simple-as-fuck/http-codes",
    "description": "Small PHP library for easily accessing HTTP Status Codes.",
    "keywords": ["http", "http status", "status code"],
    "authors": [
        {
            "name": "Johan Vester",
            "homepage": "http://jvester.se"
        }
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "spaze/phpstan-disallowed-calls": "^4.15",
        "shipmonk/dead-code-detector": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Kayex\\": "src/"
        }
    }
}
